{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-create",
    "allow-get-update-channel",
    "allow-get-update-status",
    "allow-install-update",
    "allow-snooze-update",
    "allow-embedded-webview-show",
    "allow-embedded-webview-hide",
    "allow-embedded-webview-navigate",
    "allow-embedded-webview-close",
    "allow-embedded-webview-eval",
    "allow-embedded-webview-read-session",
    "allow-embedded-vision-begin-session",
    "allow-embedded-vision-end-session",
    "allow-embedded-webview-vision-capture",
    "allow-embedded-webview-vision-click",
    "allow-embedded-webview-vision-type",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/node",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:allow-open"
  ]
}
