{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "gigradar",
  "version": "0.31.1",
  "identifier": "com.mdostal.gigradar",
  "build": {
    "frontendDist": "dist-placeholder",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && bash scripts/prepare-tauri-sidecars.sh"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": [
      "resources/server/**/*",
      "resources/playwright-browsers/**/*"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFNjU0MjcxODlGMUFCRTAKUldUZ3EvR0pjVUpsN3NYZEtOZWd6TDZHL0I5cWNrUUt6cXJUYlRPRlhURURGcDNCdzRrb3RsS20K",
      "endpoints": [
        "https://github.com/mdostal/gigradar/releases/latest/download/latest.json"
      ]
    }
  }
}
