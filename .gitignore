node_modules/
.next/
out/
dist/
.env
.env.local
# belt-and-suspenders: config.json holds no secrets itself but still never
# belongs in the repo (see src/lib/config/load.ts) — only config.example.json
# (a different filename) is meant to be committed.
config.json
*.log
.DS_Store
# tsc --incremental build cache (tsconfig.json's "incremental": true, added
# by `next dev`'s auto-reconfiguration) — a local build artifact, not source.
tsconfig.tsbuildinfo
# never commit local session state / user profiles / creds
.local/
run-logs/
sessions/
# belt-and-suspenders: session files default outside the repo tree
# (<XDG data dir>/<sourceId>-session.json — see src/lib/auth/session-capture.ts),
# but never let a stray one get committed either
*-session.json
# belt-and-suspenders: the gig store defaults outside the repo tree (see
# src/lib/store/path.ts), but never let a stray local db get committed either
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.playwright-mcp/
.playwright-mcp/
# scripts/update.sh's local dev-service log/state dir (see that script's own header comment)
.run/
# tauri-installer epic: generated/downloaded, never committed --
# scripts/prepare-tauri-sidecars.sh regenerates all of these on demand.
src-tauri/target/
src-tauri/binaries/
src-tauri/resources/
src-tauri/gen/
# tauri-real-auto-update story: the LOCAL TEST updater signing keypair's
# private half -- never committed, regenerate with `npx tauri signer
# generate` if lost. The real production signing key is vaulted in the
# owner's own secrets manager, a separate, later, owner-gated step (see
# design-discussion.md's resolved Open Question 3) -- this test key exists
# only so this story's own dev-loop testing has something to sign with.
src-tauri/test-signing.key

# Hive planning-tool session bookkeeping -- internal dev-process metadata
# (agent run transcripts' local file paths, session interrupt records,
# per-run token/timing telemetry), not gigradar itself. Distinct from
# .pHive/epics/, which IS committed on purpose (sidecar_retention:
# committed in each epic.yaml; ~35 source files link to its design docs).
.pHive/agent-complete/
.pHive/interrupts/
.pHive/metrics/
.pHive/session-effort.txt
.pHive/cycle-state/
