{
  "name": "gigradar",
  "version": "0.29.0",
  "private": false,
  "license": "MIT",
  "description": "Open-source gig radar: define your accounts, needs, and role — it tracks and finds matching fractional/contract roles across the sources you enable, runs on a schedule, and assists the apply.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdostal/gigradar.git"
  },
  "homepage": "https://mdostal.github.io/gigradar",
  "bugs": {
    "url": "https://github.com/mdostal/gigradar/issues"
  },
  "author": "Mathew Dostal",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-sqlite next dev -H 127.0.0.1",
    "build": "NODE_OPTIONS=--experimental-sqlite next build",
    "start": "NODE_OPTIONS=--experimental-sqlite next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-sqlite vitest run",
    "radar": "NODE_OPTIONS=--experimental-sqlite tsx src/lib/apply/runner.ts",
    "mcp": "NODE_OPTIONS=--experimental-sqlite tsx src/mcp/server.ts",
    "scheduler": "NODE_OPTIONS=--experimental-sqlite tsx src/scheduler/index.ts",
    "electron": "npm run build && electron electron/main.ts",
    "update": "bash scripts/update.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.39",
    "@ai-sdk/google": "^4.0.45",
    "@ai-sdk/openai": "^4.0.43",
    "@anthropic-ai/claude-agent-sdk": "^0.3.235",
    "@anthropic-ai/sdk": "^0.116.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "ai": "^7.0.68",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "next": "^15.0.0",
    "playwright": "^1.62.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "electron": "^43.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
